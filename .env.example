# VocaDB
VOCADB_BASE_URL=https://vocadb.net/api
VOCADB_TIMEOUT_SECONDS=20

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=public

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vocap-previews

# Optional: used when exposing public object URLs
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Optional override; default is built from R2_ACCOUNT_ID
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com
